# ─────────────────────────────────────────────────────────────────────────────
# Child repos are registered as git submodules (see .gitmodules + README).
# Each one is an independent git repository (own .git, own remote, own deploy
# target). The umbrella pins them at a specific commit; bump with:
#   git submodule update --remote --merge
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
.turbo/

# Tests
coverage/

# Env (each child may also have its own .env.example tracked)
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
*.log

# Vercel
.vercel
